# StockFlow Environment Variables

# Neon PostgreSQL connection string
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/stockflow?sslmode=require
DATABASE_URL=

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Application
NODE_ENV=development
PORT=8787